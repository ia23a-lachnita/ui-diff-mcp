{
  "name": "ui-diff-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ui-diff-mcp": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude \"tests/live/**/*.test.ts\" --exclude \"tests/integration/**/*.test.ts\"",
    "test:integration": "npm run build && vitest run tests/integration/",
    "test:watch": "vitest --exclude \"tests/live/**/*.test.ts\" --exclude \"tests/integration/**/*.test.ts\"",
    "test:coverage": "vitest run --coverage --exclude \"tests/live/**/*.test.ts\" --exclude \"tests/integration/**/*.test.ts\"",
    "test:live": "vitest run tests/live/ --testTimeout 180000",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:integration",
    "verify:live": "node scripts/require-live-env.js && npm run build && npm run test:live",
    "verify:calorix-live": "npm run build && vitest run tests/live/calorix-smoke.live.test.ts --testTimeout 240000",
    "start": "node dist/src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "sharp": "0.35.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/pixelmatch": "5.2.6",
    "@types/node": "^22.19.0",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "4.1.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
