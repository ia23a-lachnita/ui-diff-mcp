# OpenCode Zen free visual route. The current public route needs no secret.
# OPENCODE_API_KEY=public
# OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1

# Direct Gemini API key — required for free_gemini mode and optional Gemini fallback routes.
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Direct Mistral API key — required for free_mistral mode and optional Mistral fallback routes.
MISTRAL_API_KEY=
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# OpenRouter API key — required only for free_openrouter or OpenRouter fallback routes.
# Free-tier account: 50 req/day without credits, 1000/day with $10+ purchased.
OPENROUTER_API_KEY=

# NVIDIA Build/NIM API key — required for free_nvidia mode and optional NVIDIA fallback routes.
NVIDIA_API_KEY=

# Override NVIDIA VLM base URL for self-hosted NIM containers. Optional.
# NVIDIA_VLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Paid routes require both mode="paid" and this exact switch.
# Leave unset unless paid model use is intentional.
# UI_DIFF_ENABLE_PAID_MODE=1

# LocateAnything sidecar URL. Defaults to http://127.0.0.1:39731 when unset.
LOCATEANYTHING_SIDECAR_URL=http://127.0.0.1:39731

# Required only when starting the local LocateAnything sidecar.
# LOCATEANYTHING_EAGLE_EMBODIED_DIR=C:\Users\xursc\projects\Eagle\Embodied
# Optional interpreter override for local sidecar startup. Defaults to the known LocateAnything venv when present.
# LOCATEANYTHING_PYTHON=C:\Users\xursc\projects\.venvs\ui-diff-mcp-locateanything\Scripts\python.exe
# Diagnostic mode: skips the LocateAnything 3B worker and uses CV/OCR/optional parser lanes only.
# LOCATEANYTHING_SKIP_MODEL=1

# Optional local sidecar tuning (these match the helper-script defaults).
# LOCATEANYTHING_IN_TOKEN_LIMIT=4096
# LOCATEANYTHING_GENERATION_MODE=hybrid
# LOCATEANYTHING_MAX_NEW_TOKENS=512
# LOCATEANYTHING_TIMEOUT_MS=300000

# Cap element pairs audited per run. When set, the report marks auditLimited=true.
# Omit for unbounded full-audit runs (required for verify:calorix-full-live).
# UI_DIFF_MAX_AUDIT_PAIRS=3

# Provider failure diagnostic snippet size in characters (default: 300).
# Snippet is stored in provider-trace.json — no full raw bodies are stored.
# UI_DIFF_PROVIDER_DIAGNOSTIC_SNIPPET_CHARS=300

# Recovery budget controls. Defaults below are used when variables are unset.
# Compatibility name: this is now an internal recovery batch size, not a terminal component cap.
# UI_DIFF_MAX_RECOVERY_COMPONENTS=12
# UI_DIFF_MAX_RECOVERY_MODEL_CALLS=200
# UI_DIFF_RECOVERY_BUDGET_MS=900000
